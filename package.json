{
  "name": "emd-minecraft",
  "version": "0.1.0",
  "description": "Everything Minecraft Development: live version data, proven presets and AI skills for building Minecraft plugins, mods and packs.",
  "type": "module",
  "bin": {
    "emd": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotSkrib/emd.git"
  },
  "bugs": {
    "url": "https://github.com/NotSkrib/emd/issues"
  },
  "homepage": "https://github.com/NotSkrib/emd#readme",
  "files": [
    "dist",
    "data",
    "presets",
    "skills",
    "agents",
    "commands",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "prove": "node scripts/prove-presets.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "minecraft",
    "paper",
    "fabric",
    "neoforge",
    "forge",
    "velocity",
    "datapack",
    "resourcepack",
    "ai-agents",
    "agent-skills"
  ],
  "author": "notskrib",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
